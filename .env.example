# Proposed server-side variables; no application consumes these yet.
# Copy to .env.local and supply real values only outside Git.
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=
# X API app-only credentials belong on the backend, never in VITE_*.
# Account/Developer setup is reported complete; live access is not verified.
X_API_BASE_URL=https://api.x.com/2
X_API_BEARER_TOKEN=
# This proposed switch still needs implementation and verification.
X_API_ENABLED=false
# Decide limits in the specification before enabling paid execution.
AGENT_MAX_STEPS=
AGENT_TIMEOUT_SECONDS=
AGENT_MAX_COST_USD=
# Implement and test this switch before relying on it.
AGENT_DRY_RUN=true
