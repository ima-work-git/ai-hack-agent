# Copy to .env.local. Keep real credentials out of Git and the browser.
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://localhost:4173
# Required (16+ characters) for live mode and any non-loopback hosting.
APP_ACCESS_CODE=
PRIVATE_DIR=.private

# Safe default: no paid API calls; fictional local fixtures remain available.
AGENT_LIVE_ENABLED=false
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=
TAVILY_API_KEY=
# Explicit account or a verified public-identity mapping. Optional, disabled by default.
X_API_ENABLED=false
X_API_BEARER_TOKEN=
# Prefer 2 latest X posts + 1 past-response post + 1 profile/company card.
# Default true when X is used. false keeps the legacy lookup + five-post route.
X_BALANCED_TOPICS=true

# Optional delayed public Instagram/Facebook enrichment, server-only token.
# Each platform: at most 3 posts, $0.10 actor ceiling, no paid subscription.
# Only individually verified public accounts are fetched. Never social cookies.
APIFY_ENABLED=false
APIFY_API_TOKEN=

# Conversation mode: direct OpenAI streaming transcription, server-only key.
# Missing key or explicit per-minute maximum disables streaming.
OPENAI_API_KEY=
OPENAI_STREAMING_ASR_MODEL=gpt-live-transcribe
STREAMING_ASR_MAX_USD_PER_MINUTE=

# Public-figure name correction; enabled by default when OPENAI_API_KEY is set.
# ASR spelling candidates never become verified identity aliases.
# Set false to disable this optional correction call. Server-only credentials.
PERSON_CORRECTION_ENABLED=true
PERSON_CORRECTION_MODEL=gpt-5.6-luna

# Optional short-recording mode: OrcaRouter model with input_audio support.
ORCAROUTER_STT_MODEL=
# Alternatively, all three explicit OpenAI-compatible STT settings.
# Partial explicit STT settings disable STT (no silent fallback).
STT_API_BASE_URL=
STT_API_KEY=
STT_MODEL=

# USD, all explicitly set before live mode. Obtain current maximum prices
# for your selected APIs/models and include input/output tokens and retries.
# Unknown actual cost retains this upper-bound reservation, including failures.
RUN_BUDGET_USD=
DAY_BUDGET_USD=
EVENT_BUDGET_USD=
# Optional, explicit ISO timestamps with timezone; both blank means normal caps.
# During this fixed window (at most 48 hours), only run/day/event amount stops
# are suspended. Accounting and reservations continue; normal caps resume at UNTIL.
BUDGET_LIMITS_SUSPEND_FROM=
BUDGET_LIMITS_SUSPEND_UNTIL=
MAX_LLM_CALL_USD=
MAX_SEARCH_CALL_USD=
# For direct public page retrieval, explicitly set 0 if it has no per-call fee.
MAX_PAGE_CALL_USD=
# Balanced X: conservatively reserve 1 user + 35 posts (36 resources):
# latest 5 + archive 20 + recency fallback 10 only if the timeline is empty.
# Up to 4 HTTP calls including lookup; no pagination or fallback retries.
# Set a conservative combined maximum per attempt using current API prices.
# Legacy (X_BALANCED_TOPICS=false): 1 user + at most 5 posts.
# Unknown billed cost retains this reservation; displayed estimates are not invoices.
X_MAX_SEARCH_COST_USD=
MAX_STT_CALL_USD=
