{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "noEmit": true, "strict": true, "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true, "verbatimModuleSyntax": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src", "server", "tests", "vite.config.ts"]
}
