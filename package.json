{
  "name": "ai-hack-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local server/index.ts --production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && node --input-type=module -e \"await import('./server/http.ts')\" && python3 scripts/check_preparation.py",
    "pack:g2": "node scripts/pack-g2.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.12",
    "ipaddr.js": "2.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.13",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
