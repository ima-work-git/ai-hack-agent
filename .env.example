# Copy to .env.local. Keep real credentials out of Git and the browser.
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://localhost:4173
# Required (16+ characters) for live mode and any non-loopback hosting.
APP_ACCESS_CODE=
PRIVATE_DIR=.private

# Safe default: no paid API calls; fictional local fixtures remain available.
AGENT_LIVE_ENABLED=false
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=
TAVILY_API_KEY=
# Explicit @handle or HTTPS X/Twitter profile URL. Optional, disabled by default.
X_API_ENABLED=false
X_API_BEARER_TOKEN=

# Conversation mode: direct OpenAI streaming transcription, server-only key.
# Missing key or explicit per-minute maximum disables streaming.
OPENAI_API_KEY=
OPENAI_STREAMING_ASR_MODEL=gpt-live-transcribe
STREAMING_ASR_MAX_USD_PER_MINUTE=

# Optional short-recording mode: OrcaRouter model with input_audio support.
ORCAROUTER_STT_MODEL=
# Alternatively, all three explicit OpenAI-compatible STT settings.
# Partial explicit STT settings disable STT (no silent fallback).
STT_API_BASE_URL=
STT_API_KEY=
STT_MODEL=

# USD, all explicitly set before live mode. Obtain current maximum prices
# for your selected APIs/models and include input/output tokens and retries.
# Unknown actual cost retains this upper-bound reservation, including failures.
RUN_BUDGET_USD=
DAY_BUDGET_USD=
EVENT_BUDGET_USD=
MAX_LLM_CALL_USD=
MAX_SEARCH_CALL_USD=
# For direct public page retrieval, explicitly set 0 if it has no per-call fee.
MAX_PAGE_CALL_USD=
# X: user lookup + at most five posts, combined maximum charge.
X_MAX_SEARCH_COST_USD=
MAX_STT_CALL_USD=
